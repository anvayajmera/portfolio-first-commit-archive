{
  "name": "anvay-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typeface": "node scripts/make-typeface.mjs",
    "dev": "vite",
    "build": "npm run typeface && tsc --noEmit && vite build && npm run build:worker",
    "build:worker": "rolldown server/site-worker.js --format esm --platform neutral --file dist/server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "rolldown scripts/check-scene.ts --format esm --platform node --file .cache/check-scene.mjs && node .cache/check-scene.mjs",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wawoff2": "^2.0.1"
  }
}
